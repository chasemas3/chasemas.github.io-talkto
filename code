                btn.className = `w-full flex items-center px-2 py-1.5 rounded-lg text-xs text-slate-400 hover:bg-st-hover hover:text-slate-200 transition ${activeChannel === ch ? 'bg-st-active !text-white font-semibold' : ''}`;
