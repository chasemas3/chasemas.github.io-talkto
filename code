        // Render DM list on Home Sidebar
        function renderDirectMessagesList() {
            const dmList = document.getElementById('dm-channels-list');
            dmList.innerHTML = '';

            const friendsBtn = document.createElement('button');
            friendsBtn.className = `w-full flex items-center px-2 py-2 rounded-lg text-xs text-slate-300 hover:bg-st-hover transition mb-2 ${activeChannel === 'friends' ? 'bg-st-active !text-white font-semibold' : ''}`;
