<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-950 text-slate-100 font-sans">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SchoolTalk - Study, Chat & Collaborate</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#eef2ff',
                            500: '#5865F2',
                            600: '#4752C4',
                            700: '#3C45A5'
                        },
                        st: {
                            sidebar: '#111827',
                            channels: '#1f2937',
                            chat: '#111827',
                            members: '#1f2937',
                            hover: '#374151',
                            active: '#4b5563'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #1f2937;
        }
        ::-webkit-scrollbar-thumb {
            background: #374151;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #4b5563;
        }
    </style>
</head>
<body class="h-full flex flex-col overflow-hidden select-none">

    <!-- APP CONTAINER -->
    <div id="app" class="h-full w-full flex">
        
        <!-- AUTH CONTAINER (Login / Signup Modal Screen) -->
        <div id="auth-screen" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/95 backdrop-blur-md p-4">
            <div class="bg-st-channels p-8 rounded-2xl shadow-2xl w-full max-w-md border border-slate-800">
                <div class="text-center mb-6">
                    <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-brand-500 mb-3 text-white text-3xl shadow-lg shadow-brand-500/30">
                        <i class="fa-solid fa-graduation-cap"></i>
                    </div>
                    <h2 id="auth-title" class="text-2xl font-bold text-white tracking-wide">Welcome to SchoolTalk</h2>
                    <p id="auth-subtitle" class="text-slate-400 text-sm mt-1">Connect with classmates, study groups, and campus channels.</p>
                </div>

                <form id="auth-form" onsubmit="handleAuthSubmit(event)" class="space-y-4">
                    <div>
                        <label class="block text-xs font-bold uppercase text-slate-300 mb-2">Username</label>
                        <input type="text" id="auth-username" required placeholder="e.g. Alex_Student" class="w-full bg-slate-900 border border-slate-800 rounded-xl p-3 text-white text-sm focus:outline-none focus:border-brand-500 transition">
                    </div>
                    <div>
                        <label class="block text-xs font-bold uppercase text-slate-300 mb-2">Password</label>
                        <input type="password" id="auth-password" required placeholder="••••••••" class="w-full bg-slate-900 border border-slate-800 rounded-xl p-3 text-white text-sm focus:outline-none focus:border-brand-500 transition">
                    </div>

                    <button type="submit" id="auth-submit-btn" class="w-full bg-brand-500 hover:bg-brand-600 text-white font-semibold py-3 px-4 rounded-xl shadow-md transition duration-200">
                        Log In
                    </button>
                </form>

                <div class="mt-4 text-sm text-slate-400 text-center">
                    <span id="auth-switch-text">Need a SchoolTalk account?</span>
                    <button type="button" onclick="toggleAuthMode()" id="auth-switch-btn" class="text-brand-500 hover:underline font-medium ml-1">Register</button>
                </div>
            </div>
        </div>

        <!-- MAIN SCHOOLTALK INTERFACE -->
        <div id="main-interface" class="h-full w-full flex overflow-hidden hidden">

            <!-- 1. SERVERS SIDEBAR -->
            <div class="w-18 bg-st-sidebar flex flex-col items-center py-3 gap-2 z-20 shrink-0 border-r border-slate-800/40">
                <!-- Direct Messages / Home Button -->
                <button onclick="switchGroup('home')" id="btn-home" class="group relative w-12 h-12 rounded-[24px] hover:rounded-[16px] bg-slate-800 hover:bg-brand-500 flex items-center justify-center transition-all duration-200 text-white shadow">
                    <i class="fa-solid fa-graduation-cap text-xl"></i>
                    <span class="absolute left-16 bg-slate-900 text-white text-xs px-2.5 py-1 rounded-md shadow-md whitespace-nowrap opacity-0 group-hover:opacity-100 transition duration-150 z-50 pointer-events-none border border-slate-800">Home & Friends</span>
                </button>

                <div class="w-8 h-[2px] bg-slate-800 rounded my-1"></div>

                <!-- Group Icons List -->
                <div id="server-list" class="flex-1 w-full flex flex-col items-center gap-2 overflow-y-auto no-scrollbar">
                    <!-- Dynamic server buttons appended here -->
                </div>

                <!-- Add Group Button -->
                <button onclick="openCreateGroupModal()" class="group relative w-12 h-12 rounded-[24px] hover:rounded-[16px] bg-slate-800 hover:bg-emerald-500 flex items-center justify-center transition-all duration-200 text-emerald-400 hover:text-white shadow">
                    <i class="fa-solid fa-plus text-lg"></i>
                    <span class="absolute left-16 bg-slate-900 text-white text-xs px-2.5 py-1 rounded-md shadow-md whitespace-nowrap opacity-0 group-hover:opacity-100 transition duration-150 z-50 pointer-events-none border border-slate-800">Create Study Group</span>
                </button>

                <!-- Join via Invite Code -->
                <button onclick="openJoinInviteModal()" class="group relative w-12 h-12 rounded-[24px] hover:rounded-[16px] bg-slate-800 hover:bg-sky-500 flex items-center justify-center transition-all duration-200 text-sky-400 hover:text-white shadow">
                    <i class="fa-solid fa-compass text-lg"></i>
                    <span class="absolute left-16 bg-slate-900 text-white text-xs px-2.5 py-1 rounded-md shadow-md whitespace-nowrap opacity-0 group-hover:opacity-100 transition duration-150 z-50 pointer-events-none border border-slate-800">Join via Invite Code</span>
                </button>
            </div>

            <!-- 2. CHANNELS & VOICE CONTROL PANEL -->
            <div class="w-60 bg-st-channels flex flex-col shrink-0 z-10 border-r border-slate-800/40">
                <!-- Group Header -->
                <div class="h-12 border-b border-slate-800 px-4 flex items-center justify-between shadow-sm">
                    <h1 id="current-group-title" class="font-bold text-white truncate text-sm">Computer Science 101</h1>
                    <div class="flex items-center space-x-1">
                        <button id="add-member-btn" onclick="openAddMemberModal()" class="text-slate-400 hover:text-emerald-400 text-xs px-2 py-1 rounded bg-slate-800 hover:bg-slate-700 transition flex items-center gap-1" title="Add Friend to Group">
                            <i class="fa-solid fa-user-plus text-[10px]"></i>
                        </button>
                        <button id="invite-btn" onclick="showInviteCodeModal()" class="text-slate-400 hover:text-white text-xs px-2 py-1 rounded bg-slate-800 hover:bg-slate-700 transition flex items-center gap-1" title="Get Invite Code">
                            <i class="fa-solid fa-link text-[10px]"></i> Invite
                        </button>
                    </div>
                </div>

                <!-- Channels Scrollable Area -->
                <div id="channels-panel-content" class="flex-1 overflow-y-auto p-2 space-y-4">
                    <!-- Text Channels Section -->
                    <div id="text-channels-section">
                        <div class="flex items-center justify-between text-[11px] font-bold text-slate-400 px-2 mb-1 uppercase tracking-wider">
                            <span><i class="fa-solid fa-chevron-down text-[9px] mr-1"></i> Text Channels</span>
                        </div>
                        <div id="text-channels-list" class="space-y-0.5">
                            <!-- Dynamic Text Channels -->
                        </div>
                    </div>

                    <!-- Voice Channels Section -->
                    <div id="voice-channels-section">
                        <div class="flex items-center justify-between text-[11px] font-bold text-slate-400 px-2 mb-1 uppercase tracking-wider">
                            <span><i class="fa-solid fa-chevron-down text-[9px] mr-1"></i> Voice Channels</span>
                        </div>
                        <div id="voice-channels-list" class="space-y-0.5">
                            <!-- Dynamic Voice Channels -->
                        </div>
                    </div>

                    <!-- Direct Messages Section (Home view) -->
                    <div id="dm-channels-section" class="hidden">
                        <div class="flex items-center justify-between text-[11px] font-bold text-slate-400 px-2 mb-1 uppercase tracking-wider">
                            <span>Direct Messages</span>
                        </div>
                        <div id="dm-channels-list" class="space-y-0.5">
                            <!-- Dynamic DMs -->
                        </div>
                    </div>
                </div>

                <!-- VOICE CALL CONTROL PANEL (Bottom Left Active Call Card) -->
                <div id="voice-panel" class="hidden bg-slate-950 p-3 border-t border-slate-800 flex flex-col gap-2.5">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center space-x-2">
                            <span class="relative flex h-2.5 w-2.5">
                              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                              <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
                            </span>
                            <div>
                                <div class="text-xs font-semibold text-emerald-400">Voice Connected</div>
                                <div id="voice-channel-name" class="text-[10px] text-slate-400 truncate max-w-[110px]">Study Lounge</div>
                            </div>
                        </div>
                        <button onclick="leaveVoiceCall()" class="text-rose-400 hover:text-rose-300 p-1.5 rounded-lg bg-rose-500/10 hover:bg-rose-500/20 transition" title="Disconnect">
                            <i class="fa-solid fa-phone-slash text-xs"></i>
                        </button>
                    </div>

                    <!-- Audio Visualizer Waveform -->
                    <div class="flex items-center justify-center space-x-1 h-5 bg-slate-900 rounded-lg p-1 border border-slate-800">
                        <div id="bar1" class="w-1 bg-emerald-500 rounded-full h-1 transition-all duration-75"></div>
                        <div id="bar2" class="w-1 bg-emerald-500 rounded-full h-2 transition-all duration-75"></div>
                        <div id="bar3" class="w-1 bg-emerald-500 rounded-full h-1 transition-all duration-75"></div>
                        <div id="bar4" class="w-1 bg-emerald-500 rounded-full h-3 transition-all duration-75"></div>
                        <div id="bar5" class="w-1 bg-emerald-500 rounded-full h-1 transition-all duration-75"></div>
                    </div>

                    <!-- Voice Control Buttons: Mute & Deafen -->
                    <div class="flex items-center justify-between bg-slate-900 rounded-lg p-1 border border-slate-800 gap-1">
                        <button id="mute-btn" onclick="toggleMute()" class="flex-1 py-1.5 px-2 text-xs text-slate-300 hover:bg-slate-800 rounded-md flex items-center justify-center space-x-1.5 transition">
                            <i id="mute-icon" class="fa-solid fa-microphone"></i>
                            <span id="mute-text">Mute</span>
                        </button>
                        <button id="deafen-btn" onclick="toggleDeafen()" class="flex-1 py-1.5 px-2 text-xs text-slate-300 hover:bg-slate-800 rounded-md flex items-center justify-center space-x-1.5 transition">
                            <i id="deafen-icon" class="fa-solid fa-headphones"></i>
                            <span id="deafen-text">Deafen</span>
                        </button>
                    </div>
                </div>

                <!-- USER PROFILE FOOTER -->
                <div class="h-14 bg-slate-950 px-2 flex items-center justify-between border-t border-slate-800/80">
                    <div class="flex items-center space-x-2.5 overflow-hidden cursor-pointer p-1.5 rounded-lg hover:bg-slate-800 transition flex-1" onclick="openProfileModal()">
                        <div class="relative">
                            <img id="user-avatar-img" src="https://api.dicebear.com/7.x/bottts/svg?seed=Student" class="w-8 h-8 rounded-full bg-slate-700 object-cover border border-slate-700">
                            <span class="absolute bottom-0 right-0 w-2.5 h-2.5 bg-emerald-500 border-2 border-slate-950 rounded-full"></span>
                        </div>
                        <div class="truncate">
                            <div id="user-display-name" class="text-xs font-bold text-white truncate">Username</div>
                            <div class="text-[10px] text-slate-400 truncate">Online</div>
                        </div>
                    </div>

                    <button onclick="logout()" class="text-slate-400 hover:text-rose-400 p-2 rounded-lg hover:bg-slate-800 transition" title="Log Out">
                        <i class="fa-solid fa-right-from-bracket text-xs"></i>
                    </button>
                </div>
            </div>

            <!-- 3. MAIN CHAT & CALL WINDOW -->
            <div class="flex-1 bg-st-chat flex flex-col h-full overflow-hidden">
                <!-- Chat Header -->
                <div class="h-12 border-b border-slate-800 px-4 flex items-center justify-between shrink-0 shadow-sm bg-slate-900/40">
                    <div class="flex items-center space-x-2">
                        <span id="chat-header-hash" class="text-slate-400 text-lg font-bold">#</span>
                        <span id="chat-header-title" class="font-bold text-white text-sm">general</span>
                    </div>
                    <!-- Home Friends Top Navigation Tabs -->
                    <div id="friends-nav-tabs" class="flex items-center space-x-2">
                        <button onclick="setFriendsTab('online')" id="tab-friends-online" class="px-2.5 py-1 rounded-md text-xs font-medium text-white bg-slate-800">Online</button>
                        <button onclick="setFriendsTab('all')" id="tab-friends-all" class="px-2.5 py-1 rounded-md text-xs font-medium text-slate-400 hover:text-white transition">All Friends</button>
                        <button onclick="setFriendsTab('pending')" id="tab-friends-pending" class="relative px-2.5 py-1 rounded-md text-xs font-medium text-slate-400 hover:text-white transition">
                            Pending
                            <span id="pending-badge" class="hidden absolute -top-1 -right-1 bg-rose-500 text-white text-[9px] px-1.5 py-0.2 rounded-full font-bold">0</span>
                        </button>
                        <button onclick="setFriendsTab('add')" id="tab-friends-add" class="px-2.5 py-1 rounded-md text-xs font-semibold text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 hover:bg-emerald-500/20 transition">Add Friend</button>
                    </div>
                </div>

                <!-- Friends Dashboard Area -->
                <div id="friends-dashboard" class="flex-1 overflow-y-auto p-6 hidden">
                    <!-- Add Friend Tab Content -->
                    <div id="friends-tab-add-content" class="max-w-2xl">
                        <h2 class="text-lg font-bold text-white uppercase tracking-wide text-xs mb-1">Add Friend</h2>
                        <p class="text-xs text-slate-400 mb-4">You can add classmates by searching their username or selecting from discovered SchoolTalk students.</p>
                        
                        <div class="flex items-center bg-slate-900 border border-slate-800 rounded-xl p-2 mb-6 focus-within:border-brand-500">
                            <input type="text" id="add-friend-input" placeholder="You can add friends with their SchoolTalk username..." class="bg-transparent flex-1 px-3 text-white text-sm focus:outline-none">
                            <button onclick="sendFriendRequestFromInput()" class="bg-brand-500 hover:bg-brand-600 text-white text-xs font-semibold px-4 py-2 rounded-lg transition shadow">Send Request</button>
                        </div>

                        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3">Discover Classmates</h3>
                        <div id="discover-users-list" class="space-y-2">
                            <!-- Dynamically populated registered users -->
                        </div>
                    </div>

                    <!-- Friends List Tabs (Online / All / Pending) -->
                    <div id="friends-tab-list-content">
                        <div id="friends-list-container" class="space-y-2 max-w-3xl">
                            <!-- Dynamic Friends / Pending items -->
                        </div>
                    </div>
                </div>

                <!-- Messages Container -->
                <div id="messages-container" class="flex-1 overflow-y-auto p-4 space-y-4">
                    <!-- Messages dynamically rendered -->
                </div>

                <!-- Chat Input Form -->
                <div id="chat-input-wrapper" class="p-4 shrink-0 bg-slate-950/40 border-t border-slate-800/50">
                    <form onsubmit="sendMessage(event)" class="bg-slate-900 rounded-xl px-4 py-3 flex items-center space-x-3 border border-slate-800 focus-within:border-brand-500 transition">
                        <input type="text" id="chat-input" placeholder="Message #general" class="bg-transparent flex-1 text-white text-sm focus:outline-none placeholder-slate-500">
                        <button type="submit" class="text-brand-500 hover:text-brand-600 transition p-1">
                            <i class="fa-solid fa-paper-plane text-base"></i>
                        </button>
                    </form>
                </div>
            </div>

            <!-- 4. MEMBERS LIST SIDEBAR -->
            <div class="w-60 bg-st-members hidden lg:flex flex-col shrink-0 border-l border-slate-800/40 p-3">
                <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-3 px-2">
                    Classmates — <span id="online-count">1</span>
                </div>
                <div id="members-list" class="space-y-1 overflow-y-auto">
                    <!-- Dynamic Members appended -->
                </div>
            </div>

        </div>

    </div>

    <!-- MODALS -->

    <!-- Profile Edit / Avatar Upload Modal -->
    <div id="profile-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/70 backdrop-blur-sm hidden">
        <div class="bg-st-channels p-6 rounded-2xl shadow-2xl w-full max-w-md border border-slate-800">
            <h3 class="text-xl font-bold text-white mb-4">Edit SchoolTalk Profile</h3>
            <div class="flex flex-col items-center mb-6 space-y-4">
                <img id="modal-avatar-preview" src="" class="w-24 h-24 rounded-full bg-slate-800 object-cover border-4 border-brand-500 shadow-md">
                <label class="cursor-pointer bg-brand-500 hover:bg-brand-600 text-white text-xs font-semibold py-2.5 px-4 rounded-xl transition shadow">
                    Upload Custom Picture
                    <input type="file" id="avatar-file-input" accept="image/*" class="hidden" onchange="handleAvatarUpload(event)">
                </label>
            </div>
            <div class="flex justify-end space-x-2">
                <button onclick="closeProfileModal()" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-white text-xs rounded-xl transition">Done</button>
            </div>
        </div>
    </div>

    <!-- Create Group Modal -->
    <div id="create-group-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/70 backdrop-blur-sm hidden">
        <div class="bg-st-channels p-6 rounded-2xl shadow-2xl w-full max-w-md border border-slate-800">
            <h3 class="text-xl font-bold text-white mb-1">Create a Study Group</h3>
            <p class="text-xs text-slate-400 mb-4">Set up a space for your class, project team, or student club.</p>
            <input type="text" id="new-group-name" placeholder="e.g. Physics Project Squad" class="w-full bg-slate-900 border border-slate-800 rounded-xl p-3 text-white text-sm focus:outline-none focus:border-brand-500 mb-4">
            <div class="flex justify-end space-x-2">
                <button onclick="closeCreateGroupModal()" class="px-4 py-2 text-slate-400 hover:text-white text-xs transition">Cancel</button>
                <button onclick="createGroup()" class="px-4 py-2 bg-brand-500 hover:bg-brand-600 text-white text-xs font-semibold rounded-xl transition shadow">Create Group</button>
            </div>
        </div>
    </div>
    <!-- Add Friend Direct to Server Modal -->
    <div id="add-member-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/70 backdrop-blur-sm hidden">
        <div class="bg-st-channels p-6 rounded-2xl shadow-2xl w-full max-w-md border border-slate-800">
            <h3 class="text-xl font-bold text-white mb-1">Add Friends to Group</h3>
            <p class="text-xs text-slate-400 mb-4">Select friends to instantly invite them to this study group.</p>
            <div id="invite-friends-list" class="space-y-2 max-h-60 overflow-y-auto mb-4 p-1">
                <!-- Dynamically populated friend items -->
            </div>
            <div class="flex justify-end">
                <button onclick="closeAddMemberModal()" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-white text-xs rounded-xl transition">Done</button>
            </div>
        </div>
    </div>

    <!-- View Invite Modal -->
    <div id="show-invite-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-slate-950/70 backdrop-blur-sm hidden">
        <div class="bg-st-channels p-6 rounded-2xl shadow-2xl w-full max-w-md border border-slate-800">
            <h3 class="text-xl font-bold text-white mb-1">Invite Classmates</h3>
            <p class="text-xs text-slate-400 mb-4">Share this code with other students so they can join this group.</p>
            <div class="flex items-center space-x-2 mb-4">
                <input type="text" id="display-invite-code" readonly class="w-full bg-slate-900 border border-slate-800 rounded-xl p-3 text-brand-500 font-mono text-sm focus:outline-none">
                <button onclick="copyInviteCode()" class="px-4 py-3 bg-brand-500 hover:bg-brand-600 text-white text-xs font-semibold rounded-xl transition shadow shrink-0">Copy Code</button>
            </div>
            <div class="flex justify-end">
                <button onclick="closeShowInviteModal()" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-white text-xs rounded-xl transition">Done</button>
            </div>
        </div>
    </div>

    <!-- JAVASCRIPT APP LOGIC -->
    <script>
        // State Storage
        let isLogin = true;
        let currentUser = null;
        let activeGroupId = 'home';
        let activeChannel = 'friends'; // 'friends' or text channel name or DM username
        let activeFriendsTab = 'online';
        let inVoiceCall = false;
        let isMuted = false;
        let isDeafened = false;
        let voiceInterval = null;

        // Registered Users Database Mock
        let registeredUsers = [
            { username: 'Jordan_Code', avatar: 'https://api.dicebear.com/7.x/bottts/svg?seed=Jordan' },
            { username: 'Taylor_Notes', avatar: 'https://api.dicebear.com/7.x/bottts/svg?seed=Taylor' },
            { username: 'Morgan_Physics', avatar: 'https://api.dicebear.com/7.x/bottts/svg?seed=Morgan' },
            { username: 'Alex_Chem', avatar: 'https://api.dicebear.com/7.x/bottts/svg?seed=Alex' },
            { username: 'Casey_Bio', avatar: 'https://api.dicebear.com/7.x/bottts/svg?seed=Casey' }
        ];

        // Friends & Direct Messages State
        let friends = [
            { username: 'Jordan_Code', avatar: 'https://api.dicebear.com/7.x/bottts/svg?seed=Jordan', status: 'online' },
            { username: 'Taylor_Notes', avatar: 'https://api.dicebear.com/7.x/bottts/svg?seed=Taylor', status: 'offline' }
        ];
        let pendingRequests = [
            { username: 'Morgan_Physics', avatar: 'https://api.dicebear.com/7.x/bottts/svg?seed=Morgan', type: 'incoming' }
        ];
        let dmMessages = {
            'Jordan_Code': [
                { sender: 'Jordan_Code', avatar: 'https://api.dicebear.com/7.x/bottts/svg?seed=Jordan', text: 'Hey! Ready for the CS study group?' }
            ]
        };

        // Initial Sample School Groups
        let groups = [
            {
                id: 'grp-1',
                name: 'Computer Science 101',
                inviteCode: 'ST-CS101',
                icon: '💻',
                members: ['Jordan_Code', 'Taylor_Notes'],
                textChannels: ['general', 'homework-help', 'exam-prep'],
                voiceChannels: ['Study Lounge', 'Lab Voice'],
                messages: {
                    'general': [
                        { sender: 'Professor_Ada', avatar: 'https://api.dicebear.com/7.x/bottts/svg?seed=Ada', text: 'Welcome to CS101 SchoolTalk! Office hours start at 3 PM.' }
                    ]
                }
            },
            {
                id: 'grp-2',
                name: 'Math Club & Tutoring',
                inviteCode: 'ST-MATH',
                icon: '📐',
                members: ['Taylor_Notes'],
                textChannels: ['general', 'calculus-notes'],
                voiceChannels: ['Tutoring Room'],
                messages: {
                    'general': [
                        { sender: 'MathTutor_Sam', avatar: 'https://api.dicebear.com/7.x/bottts/svg?seed=Sam', text: 'Feel free to ask calculus questions anytime!' }
                    ]
                }
            }
        ];

        // Initialization
        window.onload = function() {
            const savedUser = localStorage.getItem('schooltalk_user');
            if (savedUser) {
                currentUser = JSON.parse(savedUser);
                showMainInterface();
            }
        };

        // Switch Login / Register Mode
        function toggleAuthMode() {
            isLogin = !isLogin;
            document.getElementById('auth-title').innerText = isLogin ? 'Welcome to SchoolTalk' : 'Register for SchoolTalk';
            document.getElementById('auth-subtitle').innerText = isLogin ? 'Connect with classmates, study groups, and campus channels.' : 'Create an account to join study groups and study calls.';
            document.getElementById('auth-submit-btn').innerText = isLogin ? 'Log In' : 'Sign Up';
            document.getElementById('auth-switch-text').innerText = isLogin ? 'Need a SchoolTalk account?' : 'Already registered?';
            document.getElementById('auth-switch-btn').innerText = isLogin ? 'Register' : 'Log In';
        }

        function handleAuthSubmit(e) {
            e.preventDefault();
            const username = document.getElementById('auth-username').value.trim();
            if (!username) return;

            currentUser = {
                username: username,
                avatar: `https://api.dicebear.com/7.x/bottts/svg?seed=${username}`
            };

            if (!registeredUsers.some(u => u.username === username)) {
                registeredUsers.push(currentUser);
            }

            localStorage.setItem('schooltalk_user', JSON.stringify(currentUser));
            showMainInterface();
        }

        function logout() {
            localStorage.removeItem('schooltalk_user');
            currentUser = null;
            document.getElementById('auth-screen').classList.remove('hidden');
            document.getElementById('main-interface').classList.add('hidden');
            leaveVoiceCall();
        }

        function showMainInterface() {
            document.getElementById('auth-screen').classList.add('hidden');
            document.getElementById('main-interface').classList.remove('hidden');
            
            document.getElementById('user-display-name').innerText = currentUser.username;
            document.getElementById('user-avatar-img').src = currentUser.avatar;

            renderGroupList();
            switchGroup('home');
            updatePendingBadge();
        }

        // Group Sidebar Rendering
        function renderGroupList() {
            const list = document.getElementById('server-list');
            list.innerHTML = '';

            groups.forEach(group => {
                const btn = document.createElement('button');
                btn.className = `group relative w-12 h-12 rounded-[24px] hover:rounded-[16px] bg-slate-800 hover:bg-brand-500 flex items-center justify-center transition-all duration-200 text-white font-bold shadow text-lg ${activeGroupId === group.id ? '!rounded-[16px] !bg-brand-500' : ''}`;
                btn.onclick = () => switchGroup(group.id);
                btn.innerHTML = `
                    ${group.icon}
                    <span class="absolute left-16 bg-slate-900 text-white text-xs px-2.5 py-1 rounded-md shadow-md whitespace-nowrap opacity-0 group-hover:opacity-100 transition duration-150 z-50 pointer-events-none border border-slate-800">${group.name}</span>
                `;
                list.appendChild(btn);
            });
