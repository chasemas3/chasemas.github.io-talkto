        // Render Discover Users List for Adding Friends
        function renderDiscoverUsers() {
            const list = document.getElementById('discover-users-list');
            list.innerHTML = '';

            const availableUsers = registeredUsers.filter(u => 
                u.username !== currentUser.username && 
                !friends.some(f => f.username === u.username)
            );

            if (availableUsers.length === 0) {
                list.innerHTML = `<div class="text-xs text-slate-500 italic">No new students to discover right now.</div>`;
                return;
            }

            availableUsers.forEach(u => {
                const isPending = pendingRequests.some(p => p.username === u.username);
                const item = document.createElement('div');
                item.className = 'flex items-center justify-between p-3 bg-slate-900 border border-slate-800 rounded-xl';
                item.innerHTML = `
                    <div class="flex items-center space-x-3">
                        <img src="${u.avatar}" class="w-9 h-9 rounded-full bg-slate-800">
                        <span class="text-xs font-bold text-white">${u.username}</span>
                    </div>
                    ${isPending ? `
                        <span class="text-[10px] text-amber-400 font-medium bg-amber-400/10 px-2.5 py-1 rounded-md border border-amber-400/20">Request Sent</span>
                    ` : `
                        <button onclick="sendFriendRequest('${u.username}')" class="bg-brand-500 hover:bg-brand-600 text-white text-xs font-semibold px-3 py-1.5 rounded-lg transition shadow">Add Friend</button>
                    `}
                `;
                list.appendChild(item);
            });
        }

        function sendFriendRequestFromInput() {
            const input = document.getElementById('add-friend-input');
            const name = input.value.trim();
            if (!name) return;
            sendFriendRequest(name);
            input.value = '';
        }

        function sendFriendRequest(username) {
            if (username === currentUser.username) {
                alert("You cannot add yourself as a friend.");
                return;
            }
            if (friends.some(f => f.username === username)) {
                alert(`${username} is already your friend.`);
                return;
            }
            if (!pendingRequests.some(p => p.username === username)) {
                const targetUser = registeredUsers.find(u => u.username === username) || {
                    username: username,
                    avatar: `https://api.dicebear.com/7.x/bottts/svg?seed=${username}`
                };
                pendingRequests.push({ username: targetUser.username, avatar: targetUser.avatar, type: 'outgoing' });
                updatePendingBadge();
                renderFriendsDashboard();
            }
        }

        function acceptFriendRequest(username) {
            const reqIndex = pendingRequests.findIndex(p => p.username === username);
            if (reqIndex !== -1) {
                const req = pendingRequests[reqIndex];
                pendingRequests.splice(reqIndex, 1);
                friends.push({ username: req.username, avatar: req.avatar, status: 'online' });
                updatePendingBadge();
                renderFriendsDashboard();
            }
        }

        function declineFriendRequest(username) {
            const reqIndex = pendingRequests.findIndex(p => p.username === username);
            if (reqIndex !== -1) {
                pendingRequests.splice(reqIndex, 1);
                updatePendingBadge();
                renderFriendsDashboard();
            }
        }

        function updatePendingBadge() {
            const badge = document.getElementById('pending-badge');
            const count = pendingRequests.filter(p => p.type === 'incoming').length;
            if (count > 0) {
                badge.innerText = count;
                badge.classList.remove('hidden');
            } else {
                badge.classList.add('hidden');
            }
        }

        function openDirectMessage(username) {
            if (!dmMessages[username]) dmMessages[username] = [];
            switchChannel(username);
        }

        // Direct Server Friend Invites Modal
        function openAddMemberModal() {
            const list = document.getElementById('invite-friends-list');
            list.innerHTML = '';
            const currentGroup = groups.find(g => g.id === activeGroupId);

            if (!currentGroup) return;

            const addableFriends = friends.filter(f => !currentGroup.members || !currentGroup.members.includes(f.username));

            if (addableFriends.length === 0) {
                list.innerHTML = `<div class="text-xs text-slate-500 py-4 text-center">All your friends are already in this study group!</div>`;
            } else {
                addableFriends.forEach(f => {
                    const item = document.createElement('div');
                    item.className = 'flex items-center justify-between p-2.5 bg-slate-900 border border-slate-800 rounded-xl';
                    item.innerHTML = `
                        <div class="flex items-center space-x-2.5">
                            <img src="${f.avatar}" class="w-8 h-8 rounded-full bg-slate-800">
                            <span class="text-xs font-medium text-white">${f.username}</span>
                        </div>
                        <button onclick="addFriendToCurrentGroup('${f.username}')" class="bg-emerald-500 hover:bg-emerald-600 text-white text-xs font-semibold px-3 py-1.5 rounded-lg transition">Add</button>
                    `;
                    list.appendChild(item);
                });
            }

            document.getElementById('add-member-modal').classList.remove('hidden');
        }

        function closeAddMemberModal() {
            document.getElementById('add-member-modal').classList.add('hidden');
        }

        function addFriendToCurrentGroup(username) {
            const group = groups.find(g => g.id === activeGroupId);
            if (group) {
                if (!group.members) group.members = [];
                if (!group.members.includes(username)) {
                    group.members.push(username);
                }
                openAddMemberModal(); // Refresh modal list
                renderMemberList();
            }
        }

        // Render Messages in Chat window
        function renderMessages() {
            const container = document.getElementById('messages-container');
            container.innerHTML = '';

            let channelMsgs = [];
            if (activeGroupId === 'home') {
                channelMsgs = dmMessages[activeChannel] || [];
            } else {
                const group = groups.find(g => g.id === activeGroupId);
                if (group && group.messages && group.messages[activeChannel]) {
                    channelMsgs = group.messages[activeChannel];
                }
            }

            channelMsgs.forEach(msg => {
                const msgEl = document.createElement('div');
                msgEl.className = 'flex items-start space-x-3 group';
                msgEl.innerHTML = `
                    <img src="${msg.avatar}" class="w-9 h-9 rounded-full bg-slate-800 object-cover mt-0.5 border border-slate-700">
                    <div>
                        <div class="flex items-baseline space-x-2">
                            <span class="font-bold text-xs text-white hover:underline cursor-pointer">${msg.sender}</span>
                            <span class="text-[10px] text-slate-500">Today at 10:30 AM</span>
                        </div>
                        <div class="text-xs text-slate-300 mt-1 leading-relaxed">${msg.text}</div>
                    </div>
                `;
                container.appendChild(msgEl);
            });

            container.scrollTop = container.scrollHeight;
        }

        // Send Text Message
        function sendMessage(e) {
            e.preventDefault();
            const input = document.getElementById('chat-input');
            const text = input.value.trim();
            if (!text) return;

            if (activeGroupId === 'home') {
                if (!dmMessages[activeChannel]) dmMessages[activeChannel] = [];
                dmMessages[activeChannel].push({
                    sender: currentUser.username,
                    avatar: currentUser.avatar,
                    text: text
                });
            } else {
                const group = groups.find(g => g.id === activeGroupId);
                if (group) {
                    if (!group.messages) group.messages = {};
                    if (!group.messages[activeChannel]) group.messages[activeChannel] = [];

                    group.messages[activeChannel].push({
                        sender: currentUser.username,
                        avatar: currentUser.avatar,
                        text: text
                    });
                }
            }

            input.value = '';
            renderMessages();
        }

        // Render Classmate Member List Sidebar
        function renderMemberList() {
            const list = document.getElementById('members-list');
            list.innerHTML = '';

            let currentGroupMembers = [];
            if (activeGroupId === 'home') {
                currentGroupMembers = [currentUser, ...friends];
            } else {
                const group = groups.find(g => g.id === activeGroupId);
                const gMembers = (group && group.members) ? group.members : [];
                currentGroupMembers = [currentUser, ...friends.filter(f => gMembers.includes(f.username))];
            }

            document.getElementById('online-count').innerText = currentGroupMembers.length;

            currentGroupMembers.forEach(user => {
                const item = document.createElement('div');
                item.className = 'flex items-center space-x-2.5 p-1.5 rounded-lg hover:bg-st-hover cursor-pointer transition';
                item.innerHTML = `
                    <div class="relative">
                        <img src="${user.avatar}" class="w-7 h-7 rounded-full bg-slate-800 object-cover border border-slate-700">
                        <span class="absolute bottom-0 right-0 w-2 h-2 bg-emerald-500 border-2 border-slate-900 rounded-full"></span>
                    </div>
                    <span class="text-xs font-medium text-slate-300 truncate">${user.username || user.name}</span>
                `;
                list.appendChild(item);
            });
        }

        // Voice Call Simulated Actions
        function joinVoiceCall(channelName) {
            inVoiceCall = true;
            document.getElementById('voice-panel').classList.remove('hidden');
            document.getElementById('voice-channel-name').innerText = channelName;
            startVoiceVisualization();
        }

        function leaveVoiceCall() {
            inVoiceCall = false;
            document.getElementById('voice-panel').classList.add('hidden');
            if (voiceInterval) clearInterval(voiceInterval);
        }

        function toggleMute() {
            isMuted = !isMuted;
            const muteIcon = document.getElementById('mute-icon');
            const muteText = document.getElementById('mute-text');

            if (isMuted) {
                muteIcon.className = 'fa-solid fa-microphone-slash text-rose-400';
                muteText.innerText = 'Muted';
                muteText.className = 'text-rose-400 font-semibold';
            } else {
                muteIcon.className = 'fa-solid fa-microphone';
                muteText.innerText = 'Mute';
                muteText.className = '';
            }
        }

        function toggleDeafen() {
            isDeafened = !isDeafened;
            const deafenIcon = document.getElementById('deafen-icon');
            const deafenText = document.getElementById('deafen-text');

            if (isDeafened) {
                deafenIcon.className = 'fa-solid fa-headphones-simple text-rose-400';
                deafenText.innerText = 'Deafened';
                deafenText.className = 'text-rose-400 font-semibold';
            } else {
                deafenIcon.className = 'fa-solid fa-headphones';
                deafenText.innerText = 'Deafen';
                deafenText.className = '';
            }
        }

        function startVoiceVisualization() {
            if (voiceInterval) clearInterval(voiceInterval);
            const bars = [
                document.getElementById('bar1'),
                document.getElementById('bar2'),
                document.getElementById('bar3'),
                document.getElementById('bar4'),
                document.getElementById('bar5')
            ];

            voiceInterval = setInterval(() => {
                if (isMuted || isDeafened) {
                    bars.forEach(bar => bar.style.height = '4px');
                    return;
                }
                bars.forEach(bar => {
                    const height = Math.floor(Math.random() * 14) + 3;
                    bar.style.height = `${height}px`;
                });
            }, 80);
        }

        // Profile Avatar Upload Logic
        function openProfileModal() {
            document.getElementById('modal-avatar-preview').src = currentUser.avatar;
            document.getElementById('profile-modal').classList.remove('hidden');
        }

        function closeProfileModal() {
            document.getElementById('profile-modal').classList.add('hidden');
        }

        function handleAvatarUpload(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const dataUrl = e.target.result;
                    currentUser.avatar = dataUrl;
                    document.getElementById('user-avatar-img').src = dataUrl;
                    document.getElementById('modal-avatar-preview').src = dataUrl;
                    localStorage.setItem('schooltalk_user', JSON.stringify(currentUser));
                    renderMemberList();
                };
                reader.readAsDataURL(file);
            }
        }

        // Group Creation & Invites
        function openCreateGroupModal() {
            document.getElementById('create-group-modal').classList.remove('hidden');
        }

        function closeCreateGroupModal() {
            document.getElementById('create-group-modal').classList.add('hidden');
        }

        function createGroup() {
            const nameInput = document.getElementById('new-group-name');
            const name = nameInput.value.trim();
            if (!name) return;

            const newGroup = {
                id: `grp-${Date.now()}`,
                name: name,
                inviteCode: `ST-${Math.floor(1000 + Math.random() * 9000)}`,
                icon: name.charAt(0).toUpperCase(),
                textChannels: ['general', 'study-resources'],
                voiceChannels: ['Study Voice Room'],
                messages: {
                    'general': [{ sender: 'System', avatar: 'https://api.dicebear.com/7.x/bottts/svg?seed=SchoolTalk', text: `Welcome to the ${name} study group!` }]
                }
            };

            groups.push(newGroup);
            nameInput.value = '';
            closeCreateGroupModal();
            switchGroup(newGroup.id);
        }

        function openJoinInviteModal() {
            document.getElementById('join-invite-modal').classList.remove('hidden');
        }

        function closeJoinInviteModal() {
            document.getElementById('join-invite-modal').classList.add('hidden');
        }

        function joinGroupByInvite() {
            const codeInput = document.getElementById('invite-code-input').value.trim();
            const foundGroup = groups.find(g => g.inviteCode.toLowerCase() === codeInput.toLowerCase());

            if (foundGroup) {
                switchGroup(foundGroup.id);
                closeJoinInviteModal();
            } else {
                alert('Invalid SchoolTalk Invite Code! Try ST-CS101 or ST-MATH.');
            }
        }

        function showInviteCodeModal() {
            const group = groups.find(g => g.id === activeGroupId);
            if (group) {
                document.getElementById('display-invite-code').value = group.inviteCode;
                document.getElementById('show-invite-modal').classList.remove('hidden');
            }
        }

        function closeShowInviteModal() {
            document.getElementById('show-invite-modal').classList.add('hidden');
        }

        function copyInviteCode() {
            const copyText = document.getElementById('display-invite-code');
            copyText.select();
            document.execCommand('copy');
        }
    </script>
</body>
</html>
