        // Switch Group / Server
        function switchGroup(groupId) {
            activeGroupId = groupId;
            renderGroupList();

            const textSec = document.getElementById('text-channels-section');
            const voiceSec = document.getElementById('voice-channels-section');
            const dmSec = document.getElementById('dm-channels-section');
            const friendsTabs = document.getElementById('friends-nav-tabs');

            if (groupId === 'home') {
                document.getElementById('current-group-title').innerText = 'Friends & DMs';
                document.getElementById('invite-btn').classList.add('hidden');
                document.getElementById('add-member-btn').classList.add('hidden');
                
                textSec.classList.add('hidden');
                voiceSec.classList.add('hidden');
                dmSec.classList.remove('hidden');
                friendsTabs.classList.remove('hidden');

                renderDirectMessagesList();
                switchChannel('friends');
            } else {
                const group = groups.find(g => g.id === groupId);
                if (group) {
                    document.getElementById('current-group-title').innerText = group.name;
                    document.getElementById('invite-btn').classList.remove('hidden');
                    document.getElementById('add-member-btn').classList.remove('hidden');

                    textSec.classList.remove('hidden');
                    voiceSec.classList.remove('hidden');
                    dmSec.classList.add('hidden');
                    friendsTabs.classList.add('hidden');

                    renderChannels(group.textChannels, group.voiceChannels);
                    switchChannel(group.textChannels[0] || 'general');
                }
            }
            renderMemberList();
        }

        // Render Channels Sidebar
        function renderChannels(textChannels, voiceChannels) {
            const textList = document.getElementById('text-channels-list');
            const voiceList = document.getElementById('voice-channels-list');

            textList.innerHTML = '';
            voiceList.innerHTML = '';

            textChannels.forEach(ch => {
