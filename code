        // Switch Channel or View
        function switchChannel(channelName) {
            activeChannel = channelName;
            const friendsDash = document.getElementById('friends-dashboard');
            const messagesCont = document.getElementById('messages-container');
            const chatInputWrap = document.getElementById('chat-input-wrapper');
            const hashSpan = document.getElementById('chat-header-hash');

            if (activeGroupId === 'home') {
                renderDirectMessagesList();
                if (channelName === 'friends') {
                    friendsDash.classList.remove('hidden');
                    messagesCont.classList.add('hidden');
                    chatInputWrap.classList.add('hidden');
                    document.getElementById('chat-header-title').innerText = 'Friends';
                    hashSpan.innerHTML = '<i class="fa-solid fa-user-group text-brand-500 text-sm"></i>';
                    renderFriendsDashboard();
                } else {
                    friendsDash.classList.add('hidden');
                    messagesCont.classList.remove('hidden');
                    chatInputWrap.classList.remove('hidden');
                    document.getElementById('chat-header-title').innerText = channelName;
                    document.getElementById('chat-input').placeholder = `Message @${channelName}`;
                    hashSpan.innerText = '@';
                    renderMessages();
                }
            } else {
                friendsDash.classList.add('hidden');
                messagesCont.classList.remove('hidden');
                chatInputWrap.classList.remove('hidden');
                document.getElementById('chat-header-title').innerText = channelName;
                document.getElementById('chat-input').placeholder = `Message #${channelName}`;
                hashSpan.innerText = '#';
                renderChannels(groups.find(g=>g.id===activeGroupId).textChannels, groups.find(g=>g.id===activeGroupId).voiceChannels);
                renderMessages();
            }
        }

        // Friends Dashboard Management
        function setFriendsTab(tab) {
            activeFriendsTab = tab;
            ['online', 'all', 'pending', 'add'].forEach(t => {
                const btn = document.getElementById(`tab-friends-${t}`);
                if (t === tab) {
                    btn.className = t === 'add' ? 'px-2.5 py-1 rounded-md text-xs font-semibold text-white bg-emerald-600 shadow' : 'px-2.5 py-1 rounded-md text-xs font-medium text-white bg-slate-800 shadow';
                } else {
                    btn.className = t === 'add' ? 'px-2.5 py-1 rounded-md text-xs font-semibold text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 hover:bg-emerald-500/20 transition' : 'px-2.5 py-1 rounded-md text-xs font-medium text-slate-400 hover:text-white transition';
                }
            });
            renderFriendsDashboard();
        }

        function renderFriendsDashboard() {
            const addContent = document.getElementById('friends-tab-add-content');
            const listContent = document.getElementById('friends-tab-list-content');
            const container = document.getElementById('friends-list-container');

            if (activeFriendsTab === 'add') {
                addContent.classList.remove('hidden');
                listContent.classList.add('hidden');
                renderDiscoverUsers();
            } else {
                addContent.classList.add('hidden');
                listContent.classList.remove('hidden');
                container.innerHTML = '';

                let filterList = [];
                if (activeFriendsTab === 'online') filterList = friends.filter(f => f.status === 'online');
                else if (activeFriendsTab === 'all') filterList = friends;
                else if (activeFriendsTab === 'pending') filterList = pendingRequests;

                if (filterList.length === 0) {
                    container.innerHTML = `<div class="text-slate-500 text-xs py-8 text-center">No classmates found here.</div>`;
                    return;
                }

                filterList.forEach(item => {
                    const el = document.createElement('div');
                    el.className = 'flex items-center justify-between p-3 bg-slate-900 border border-slate-800 hover:border-slate-700 rounded-xl transition';
                    
                    if (activeFriendsTab === 'pending') {
                        el.innerHTML = `
                            <div class="flex items-center space-x-3">
                                <img src="${item.avatar}" class="w-10 h-10 rounded-full bg-slate-800">
                                <div>
                                    <div class="text-xs font-bold text-white">${item.username}</div>
                                    <div class="text-[10px] text-slate-400 capitalize">${item.type} Friend Request</div>
                                </div>
                            </div>
                            <div class="flex items-center space-x-2">
                                ${item.type === 'incoming' ? `
                                    <button onclick="acceptFriendRequest('${item.username}')" class="p-2 bg-emerald-500 hover:bg-emerald-600 text-white rounded-lg text-xs transition" title="Accept"><i class="fa-solid fa-check"></i></button>
                                ` : ''}
                                <button onclick="declineFriendRequest('${item.username}')" class="p-2 bg-rose-500/10 hover:bg-rose-500 text-rose-400 hover:text-white rounded-lg text-xs transition" title="Decline/Cancel"><i class="fa-solid fa-xmark"></i></button>
                            </div>
                        `;
                    } else {
                        el.innerHTML = `
                            <div class="flex items-center space-x-3">
                                <div class="relative">
                                    <img src="${item.avatar}" class="w-10 h-10 rounded-full bg-slate-800">
                                    <span class="absolute bottom-0 right-0 w-2.5 h-2.5 ${item.status === 'online' ? 'bg-emerald-500' : 'bg-slate-500'} border-2 border-slate-900 rounded-full"></span>
                                </div>
                                <div>
                                    <div class="text-xs font-bold text-white">${item.username}</div>
                                    <div class="text-[10px] text-slate-400 capitalize">${item.status}</div>
                                </div>
                            </div>
                            <button onclick="openDirectMessage('${item.username}')" class="p-2 bg-slate-800 hover:bg-brand-500 text-slate-300 hover:text-white rounded-lg text-xs transition flex items-center space-x-1.5">
