                    <div class="relative mr-2">
                        <img src="${friend.avatar}" class="w-5 h-5 rounded-full bg-slate-800">
                        <span class="absolute -bottom-0.5 -right-0.5 w-1.5 h-1.5 ${friend.status === 'online' ? 'bg-emerald-500' : 'bg-slate-500'} rounded-full"></span>
                    </div>
                    <span class="truncate">${friend.username}</span>
